# ─────────────────────────────────────────────────────────────
# Nifty Signal Engine — Environment Variables
# ─────────────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Fill in the values below
# 3. NEVER commit .env to Git
# ─────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────

# Gmail address used to SEND alerts (create a dedicated Gmail)
SENDER_EMAIL=your_sender_gmail@gmail.com

# Gmail App Password — NOT your login password
# Get it: myaccount.google.com → Security → App Passwords
# Format: 16 chars with spaces e.g.  abcd efgh ijkl mnop
SENDER_PASSWORD=xxxx xxxx xxxx xxxx

# Secret key to protect API endpoints
API_KEY=nifty-secret-2024-change-me

# ── OPTIONAL (defaults shown) ─────────────────────────────────

# Who receives the signals (already set to your email)
RECIPIENT_EMAIL=rishankaggarwal1994@gmail.com

# Trading capital in rupees
CAPITAL=1000000

# Risk per trade as decimal (0.015 = 1.5%)
RISK_PCT=0.015

# Server port
PORT=8000
